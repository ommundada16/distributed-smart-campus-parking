# One image for every Python node (coordinator replicas, zones, gateway, FaaS, analytics).
# What each container *is* is decided by the command it is started with - see docker-compose.yml.
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app BIND_HOST=0.0.0.0

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY config.py ./
COPY communication communication
COPY distributed distributed
COPY services services
COPY functions functions
COPY gateway gateway
COPY deploy/topology.json deploy/topology.json
